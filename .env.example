# Shopify custom app credentials. Copy to .env.local and fill in locally.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_dev_dashboard_client_id
SHOPIFY_CLIENT_SECRET=replace_with_dev_dashboard_client_secret
SHOPIFY_API_VERSION=2026-07

# Used to protect internal inventory and future cron endpoints.
CRON_SECRET=replace_with_a_long_random_value

# Reserved for Phase C snapshot storage.
BLOB_READ_WRITE_TOKEN=
